{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/bidroom/decision.schema.json",
  "title": "BidRoom Decision Record",
  "description": "Schema for a human-owned bid / no-bid decision record.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pursuit",
    "rfp",
    "decision",
    "human_owner",
    "human_signoff",
    "decision_date",
    "data_note",
    "requirements",
    "base_requirements",
    "scores",
    "base_scores",
    "total_score",
    "base_total_score",
    "base_margin_percent",
    "base_gates",
    "gates",
    "margin_percent",
    "policy_min_margin_percent",
    "conditions",
    "actions",
    "rationale",
    "uncertainty"
  ],
  "properties": {
    "pursuit": { "type": "string", "minLength": 1 },
    "rfp": { "type": "string", "minLength": 1 },
    "decision": {
      "type": "string",
      "enum": ["bid", "bid_with_partner", "no_bid"]
    },
    "human_owner": { "type": "string", "minLength": 1 },
    "human_signoff": { "type": "boolean", "const": true },
    "human_approval_ref": { "type": "string", "minLength": 1 },
    "fallback": { "type": "string", "minLength": 1 },
    "decision_date": { "type": "string", "format": "date" },
    "data_note": { "type": "string", "minLength": 1 },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/requirement" }
    },
    "base_requirements": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/requirement" }
    },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": ["technical", "past_performance", "price", "supplier_diversity"],
      "properties": {
        "technical": { "$ref": "#/$defs/scoreEntry" },
        "past_performance": { "$ref": "#/$defs/scoreEntry" },
        "price": { "$ref": "#/$defs/scoreEntry" },
        "supplier_diversity": { "$ref": "#/$defs/scoreEntry" }
      }
    },
    "base_scores": {
      "type": "object",
      "additionalProperties": false,
      "required": ["technical", "past_performance", "price", "supplier_diversity"],
      "properties": {
        "technical": { "$ref": "#/$defs/scoreEntry" },
        "past_performance": { "$ref": "#/$defs/scoreEntry" },
        "price": { "$ref": "#/$defs/scoreEntry" },
        "supplier_diversity": { "$ref": "#/$defs/scoreEntry" }
      }
    },
    "total_score": { "type": "number", "minimum": 0, "maximum": 100 },
    "base_total_score": { "type": "number", "minimum": 0, "maximum": 100 },
    "base_margin_percent": { "type": "number" },
    "base_gates": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/gate" }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/gate" }
    },
    "gate_exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gate_id", "approved_by", "approved_by_role", "reason", "date", "record_ref"],
        "properties": {
          "gate_id": { "type": "string", "enum": ["G1", "G2", "G3", "G4", "G5", "G6"] },
          "approved_by": { "type": "string", "minLength": 1 },
          "approved_by_role": { "type": "string", "const": "Pursuit Lead + Accountable Executive" },
          "reason": { "type": "string", "minLength": 10 },
          "date": { "type": "string", "format": "date" },
          "record_ref": { "type": "string", "minLength": 1 }
        }
      }
    },
    "margin_percent": { "type": "number" },
    "policy_min_margin_percent": { "type": "number" },
    "margin_exception": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approved_by", "approved_by_role", "reason", "date", "record_ref"],
      "properties": {
        "approved_by": { "type": "string", "minLength": 1 },
        "approved_by_role": { "type": "string", "const": "VP of Finance" },
        "reason": { "type": "string", "minLength": 1 },
        "date": { "type": "string", "format": "date" },
        "record_ref": { "type": "string", "minLength": 1 }
      }
    },
    "conditions": {
      "type": "array",
      "items": { "$ref": "#/$defs/actionItem" }
    },
    "actions": {
      "type": "array",
      "items": { "$ref": "#/$defs/actionItem" }
    },
    "rationale": { "type": "string", "minLength": 1 },
    "uncertainty": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "status", "evidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "status": {
          "type": "string",
          "enum": ["met", "missing", "conflicting", "partner_covered", "not_assessed"]
        },
        "evidence": { "type": "string", "minLength": 1 }
      }
    },
    "scoreEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["weight", "score", "evidence"],
      "properties": {
        "weight": { "type": "number", "exclusiveMinimum": 0 },
        "score": { "type": "number", "minimum": 1, "maximum": 5 },
        "evidence": { "type": "string", "minLength": 1 }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "status", "evidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "status": {
          "type": "string",
          "enum": ["pass", "pass_with_conditions", "fail"]
        },
        "evidence": { "type": "string", "minLength": 1 }
      }
    },
    "actionItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "owner", "due_date"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "due_date": { "type": "string", "format": "date" },
        "status": {
          "type": "string",
          "enum": ["open", "done", "blocked", "cancelled"]
        }
      }
    }
  }
}
