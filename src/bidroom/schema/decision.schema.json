{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bidroom.dev/schema/decision.schema.json",
  "title": "BidRoom Decision Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pursuit",
    "rfp",
    "decision",
    "human_owner",
    "human_signoff",
    "decision_date",
    "data_note",
    "requirements",
    "base_requirements",
    "scores",
    "base_scores",
    "total_score",
    "base_total_score",
    "base_margin_percent",
    "base_gates",
    "gates",
    "margin_percent",
    "policy_min_margin_percent",
    "conditions",
    "actions",
    "rationale",
    "uncertainty"
  ],
  "properties": {
    "pursuit": { "type": "string", "minLength": 1 },
    "rfp": { "type": "string", "minLength": 1 },
    "decision": { "type": "string", "minLength": 1 },
    "human_owner": { "type": "string", "minLength": 1 },
    "human_signoff": { "type": "boolean", "const": true },
    "human_approval_ref": { "type": "string" },
    "fallback": { "type": "string" },
    "decision_date": { "type": "string", "format": "date" },
    "data_note": { "type": "string", "minLength": 1 },
    "policy_id": { "type": "string" },
    "policy_version": { "type": "string" },
    "requirements": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/requirement" } },
    "base_requirements": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/requirement" } },
    "scores": { "$ref": "#/$defs/scores" },
    "base_scores": { "$ref": "#/$defs/scores" },
    "total_score": { "type": "number", "minimum": 0, "maximum": 100 },
    "base_total_score": { "type": "number", "minimum": 0, "maximum": 100 },
    "gates": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/gate" } },
    "base_gates": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/gate" } },
    "gate_exceptions": { "type": "array", "items": { "$ref": "#/$defs/gateException" } },
    "margin_percent": { "type": "number" },
    "base_margin_percent": { "type": "number" },
    "policy_min_margin_percent": { "type": "number" },
    "margin_exception": { "$ref": "#/$defs/marginException" },
    "conditions": { "type": "array", "items": { "$ref": "#/$defs/actionItem" } },
    "actions": { "type": "array", "items": { "$ref": "#/$defs/actionItem" } },
    "rationale": { "type": "string", "minLength": 1 },
    "uncertainty": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "status", "evidence"],
      "properties": {
        "id": { "type": "string" },
        "text": { "type": "string" },
        "status": { "type": "string" },
        "evidence": { "type": "string" }
      }
    },
    "scoreEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["weight", "score", "evidence"],
      "properties": {
        "weight": { "type": "number", "exclusiveMinimum": 0 },
        "score": { "type": "number", "minimum": 1, "maximum": 5 },
        "evidence": { "type": "string" }
      }
    },
    "scores": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/scoreEntry" }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "status", "evidence"],
      "properties": {
        "id": { "type": "string" },
        "text": { "type": "string" },
        "status": { "type": "string", "enum": ["pass", "pass_with_conditions", "fail"] },
        "evidence": { "type": "string" }
      }
    },
    "gateException": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_id", "approved_by", "approved_by_role", "reason", "date", "record_ref"],
      "properties": {
        "gate_id": { "type": "string" },
        "approved_by": { "type": "string" },
        "approved_by_role": { "type": "string" },
        "reason": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "record_ref": { "type": "string" }
      }
    },
    "marginException": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approved_by", "approved_by_role", "reason", "date", "record_ref"],
      "properties": {
        "approved_by": { "type": "string" },
        "approved_by_role": { "type": "string" },
        "reason": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "record_ref": { "type": "string" }
      }
    },
    "actionItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "owner", "due_date"],
      "properties": {
        "text": { "type": "string" },
        "owner": { "type": "string" },
        "due_date": { "type": "string", "format": "date" },
        "status": { "type": "string", "enum": ["open", "done", "blocked", "cancelled"] }
      }
    }
  }
}
