{
  "schema_version": "1.0",
  "policy_id": "northstar-bid-policy",
  "policy_version": "1.0.0",
  "description": "Fictional Meridian Digital Services bid/no-bid policy for the Northstar reference example.",
  "decision": {
    "options": ["bid", "bid_with_partner", "no_bid"],
    "bid_options": ["bid", "bid_with_partner"],
    "no_bid": "no_bid",
    "fallback_required_for": ["bid_with_partner"]
  },
  "requirements": {
    "ids": ["M1", "M2", "M3", "M4", "M5", "M6"],
    "statuses": ["met", "missing", "conflicting", "partner_covered", "not_assessed"],
    "base_partner_status": "partner_covered",
    "blocking_statuses": ["missing", "conflicting", "not_assessed"]
  },
  "scoring": {
    "formula": "weighted_sum_div_5",
    "minimum_score": 65,
    "criteria": [
      { "id": "technical", "label": "Technical approach", "weight": 40 },
      { "id": "past_performance", "label": "Past performance", "weight": 25 },
      { "id": "price", "label": "Price", "weight": 20 },
      { "id": "supplier_diversity", "label": "Supplier diversity", "weight": 15 }
    ]
  },
  "gates": [
    {
      "id": "G1",
      "text": "Mandatory requirements met or partner-covered with written evidence",
      "type": "requirements"
    },
    {
      "id": "G2",
      "text": "Weighted qualification score at least 65/100",
      "type": "score_threshold"
    },
    {
      "id": "G3",
      "text": "Margin at least 15%, or VP Finance exception",
      "type": "margin_threshold"
    },
    {
      "id": "G4",
      "text": "Key roles staffed at 50% or more for the first 90 days",
      "type": "capacity"
    },
    {
      "id": "G5",
      "text": "Deadline conflict clarified with the buyer",
      "type": "deadline"
    },
    {
      "id": "G6",
      "text": "Human approval recorded",
      "type": "human_approval"
    }
  ],
  "gate_rules": {
    "requirements_gate": "G1",
    "score_gate": "G2",
    "margin_gate": "G3",
    "capacity_gate": "G4",
    "capacity_requirement": "M4",
    "human_approval_gate": "G6"
  },
  "thresholds": {
    "minimum_margin_percent": 15,
    "gate_exception_role": "Pursuit Lead + Accountable Executive",
    "margin_exception_role": "VP of Finance"
  },
  "conditions": {
    "minimum_count": 9,
    "categories": [
      {
        "id": "deadline",
        "label": "Deadline clarification",
        "keywords": [["deadline", "clarification"], ["deadline", "response"]]
      },
      {
        "id": "attachment",
        "label": "Attachment C and page-limit/formatting",
        "keywords": [["attachment c"], ["page-limit", "formatting"], ["page limit", "formatting"]]
      },
      {
        "id": "buyer_confirmation",
        "label": "Buyer confirmation of partner coverage",
        "keywords": [["buyer confirmation", "helix"], ["buyer confirms", "helix"], ["bidder-level", "m1"]]
      },
      {
        "id": "helix_iso",
        "label": "Helix ISO certificate and fifth reference",
        "keywords": [["iso", "certificate"], ["iso", "certification"], ["fifth-reference", "letter"], ["fifth reference", "letter"]]
      },
      {
        "id": "delivery_lead",
        "label": "Helix delivery-lead commitment",
        "keywords": [["delivery", "lead", "commitment"], ["delivery-lead", "commitment"], ["delivery lead", "commitment"]]
      },
      {
        "id": "margin_exception",
        "label": "VP Finance margin exception",
        "keywords": [["margin", "exception"], ["vp finance", "exception"]]
      },
      {
        "id": "delivery_signoff",
        "label": "VP of Delivery capacity sign-off",
        "keywords": [["vp of delivery", "capacity"], ["delivery", "sign-off", "engagement director"], ["vp of delivery", "engagement director"]]
      },
      {
        "id": "supplier_diversity",
        "label": "Supplier diversity evidence",
        "keywords": [["supplier diversity"], ["diversity", "plan"]]
      },
      {
        "id": "final_go_no_go",
        "label": "Final go/no-go",
        "keywords": [["go/no-go"], ["go / no-go"], ["final", "no-bid"], ["final", "no bid"]]
      }
    ]
  },
  "data_note": {
    "required_any": ["fictional", "synthetic"],
    "forbidden_any": [
      "not fictional",
      "not synthetic",
      "real customer",
      "real client",
      "real data",
      "confidential client",
      "confidential data"
    ]
  }
}
